# Пароль владельца (не короче 16 символов): openssl rand -base64 24
SVETLANA_ADMIN_TOKEN=
# Ключ подписи подтверждений: openssl rand -hex 32
SVETLANA_SECRET=
PORT=8787
HOST=127.0.0.1
SVETLANA_DATA_DIR=/srv/svetlana/data
# Рабочая папка для кода (Светлана не выходит за её пределы)
SVETLANA_WORKSPACE=/srv/svetlana/workspace
SVETLANA_COMMAND_ALLOW=node,npm,npx,git,python3,pytest,ls,cat,tsc,eslint,vitest
# Chromium для PDF (в Docker-образе уже есть)
CHROMIUM_PATH=
# Провайдеры можно задать здесь (JSON) или во вкладке «ИИ-провайдеры». Пример: своя Qwen3-VL в РФ + запасной YandexGPT.
# SVETLANA_PROVIDERS=[{"id":"qwen","preset":"vllm","baseUrl":"http://GPU-IP:8000/v1","apiKey":"...","model":"svetlana","capabilities":["chat","tools","vision"],"extraBody":{"chat_template_kwargs":{"enable_thinking":false}}},{"id":"yandex","preset":"yandex","apiKey":"...","model":"gpt://<folder>/yandexgpt/latest","capabilities":["chat","tools"]}]
# GigaChat: NODE_EXTRA_CA_CERTS=/srv/svetlana/russian_trusted_root_ca.cer (сертификат Минцифры), ключ авторизации = apiKey
# Маркетплейс АИКО (эндпоинт из патча АИКО) и Мир самозанятых (connectors/self-employed-stp.js)
AIKO_URL=
AIKO_TOKEN=
SELF_EMPLOYED_URL=
SELF_EMPLOYED_TOKEN=
