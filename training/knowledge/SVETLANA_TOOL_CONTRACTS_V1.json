{
  "schema_version": "1.0",
  "purpose": "Machine-readable tool contracts between Svetlana skills and runtime/tool implementations.",
  "rules": {
    "contract_is_not_runtime_implementation": true,
    "runtime_execution_requires_real_evidence": true,
    "high_or_critical_risk_requires_confirmation": true,
    "critical_actions_require_postcondition_verification": true,
    "private_or_mutable_data_must_stay_out_of_model_weights": true
  },
  "contracts": [
    {
      "contract_id": "core.open_app",
      "skill_ids": ["core.agent.execution", "runtime.operations"],
      "action": "open_app",
      "risk_level": "medium",
      "input_schema": {"package": "string"},
      "confirmation": "policy_required_for_sensitive_target",
      "verification": "app_visible_or_expected_screen_observed",
      "runtime_tool_id": "open_app"
    },
    {
      "contract_id": "core.tap_element",
      "skill_ids": ["core.agent.execution", "runtime.operations"],
      "action": "tap_element",
      "risk_level": "medium",
      "input_schema": {"selector": "string"},
      "confirmation": "policy_required_for_sensitive_target",
      "verification": "expected_ui_state_changed",
      "runtime_tool_id": "tap_element"
    },
    {
      "contract_id": "core.type_text",
      "skill_ids": ["core.agent.execution", "runtime.operations"],
      "action": "type_text",
      "risk_level": "medium",
      "input_schema": {"text": "string"},
      "confirmation": "policy_required_when_target_is_sensitive",
      "verification": "target_field_contains_expected_text",
      "runtime_tool_id": "type_text"
