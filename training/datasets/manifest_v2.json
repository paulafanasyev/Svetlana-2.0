{
  "schema_version": "1.4",
  "purpose": "Single source of truth for the next Svetlana training pipeline.",
  "base_model": "google/gemma-4-E2B-it",
  "runtime_target": "LiteRT-LM",
  "training_mode": "text_production",
  "trainer": "training/gemma4/train_svetlana_production.py",
  "native_multimodal_trainer": "training/gemma4/train_svetlana_multimodal.py",
  "train": [
    {"path": "training/datasets/svetlana_seed.jsonl", "format": "messages"},
    {"path": "training/datasets/svetlana_capability_seed.jsonl", "format": "messages"},
    {"path": "training/datasets/svetlana_capability_training_v2.jsonl", "format": "messages"},
    {"path": "training/datasets/svetlana_advanced_training_v1.jsonl", "format": "messages", "role": "expanded_behavior_domain"},
    {"path": "training/datasets/svetlana_russian_source_policy_seed.jsonl", "format": "messages", "role": "source_governance_behavior"},
    {"path": "training/datasets/svetlana_source_governance_v2.jsonl", "format": "messages", "role": "source_governance_behavior_v2"},
    {"path": "training/datasets/svetlana_child_multimodal_behavior_seed.jsonl", "format": "messages", "role": "child_cv_art_finance_safety_behavior"},
    {"path": "training/datasets/svetlana_expansion_2026_v1.jsonl", "format": "messages", "role": "planned_40_direction_expansion"}
  ],
  "reference_knowledge": [
    {"path": "training/datasets/self_employed_official.jsonl", "format": "messages", "role": "official_source_behavior"}
  ],
  "pending_multimodal": [
    {"path": "training/datasets/multimodal/multimodal_training_curriculum.jsonl", "format": "multimodal_v1", "status": "requires_real_media_assets"}
  ],
  "eval": [
    {"path": "training/datasets/svetlana_eval.jsonl", "format": "messages"}
  ],
  "rules": {
    "no_personal_data_in_weights": true,
    "no_eval_in_train": true,
    "exact_duplicate_check": true,
    "normalized_duplicate_check": true,
    "near_duplicate_check": true,
    "schema_validation": true,
    "source_and_sha_required_for_knowledge": true,
    "multimodal_records_must_be_native_or_explicitly_adapted": true,
    "do_not_start_training_until_multimodal_trainer_is_ready": true,
    "do_not_start_multimodal_training_until_real_media_assets_are_present": true
  }
}
